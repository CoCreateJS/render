{
  "name": "@cocreate/render",
  "version": "2.0.0",
  "description": "A simple render component in vanilla javascript. Easily configured using HTML5 attributes and/or JavaScript API.",
  "keywords": [
    "render",
    "low-code",
    "realtime",
    "realtime-framework",
    "collaboration",
    "shared-editing",
    "html5-framework",
    "javascript-framework"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreateJS/render.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreateJS/render/issues"
  },
  "homepage": "https://CoCreateJS.com/docs/render",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreateJS"
  },
  "main": "./src/server/index.js",
  "browser": "./src/client/index.js",
  "dependencies": {
    "@cocreate/actions": "^1.24.0",
    "@cocreate/api": "^1.31.0",
    "@cocreate/element-prototype": "^1.35.0",
    "@cocreate/observer": "^1.23.0",
    "@cocreate/utils": "^1.54.0"
  },
  "devDependencies": {
    "@cocreate/webpack": "^1.9.0"
  },
  "exports": {
    ".": {
      "node": "./src/server/index.js",
      "deno": "./src/server/index.js",
      "browser": "./src/client/index.js",
      "default": "./src/server/index.js"
    },
    "./server": "./src/server/index.js",
    "./client": "./src/client/index.js"
  }
}
